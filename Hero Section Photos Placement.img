e w-full min-w-0 text-size-chat leading-relaxed"><div class="overflow-hidden" data-search-result-target="" style="max-height: 19lh;"><div><div class="text-size-chat whitespace-pre-wrap" dir="auto">&lt;!DOCTYPE html&gt;
&lt;html lang="en"&gt;

&lt;head&gt;

    &lt;meta charset="UTF-8"&gt;

    &lt;meta name="viewport"
          content="width=device-width, initial-scale=1.0"&gt;

    &lt;title&gt;Donate Items&lt;/title&gt;

    &lt;link rel="stylesheet" href="style.css"&gt;

&lt;/head&gt;

&lt;body&gt;

&lt;header&gt;

    &lt;div class="container navbar"&gt;

        &lt;div class="logo"&gt;
            &lt;a href="index.html"&gt;HomeShare&lt;/a&gt;
        &lt;/div&gt;

        &lt;nav&gt;
            &lt;a href="index.html"&gt;Home&lt;/a&gt;
            &lt;a href="browse.html"&gt;Browse Items&lt;/a&gt;
            &lt;a href="donate.html"&gt;Donate&lt;/a&gt;
            &lt;a href="about.html"&gt;About Us&lt;/a&gt;
        &lt;/nav&gt;

        &lt;a href="donate.html" class="btn"&gt;
            Donate Now
        &lt;/a&gt;

    &lt;/div&gt;

&lt;/header&gt;


&lt;section class="page-banner"&gt;

    &lt;div class="container"&gt;

        &lt;h1&gt;Donate Household Items&lt;/h1&gt;

        &lt;p&gt;
            Fill out the form below to list
            your household donation.
        &lt;/p&gt;

    &lt;/div&gt;

&lt;/section&gt;


&lt;!-- ================= DONATION FORM ================= --&gt;

&lt;section class="section"&gt;

    &lt;div class="container form-container"&gt;

        &lt;h2&gt;Donation Form&lt;/h2&gt;

        &lt;p&gt;
            Please provide details about
            the item you want to donate.
        &lt;/p&gt;

        &lt;form action="#" method="post"&gt;

            &lt;label for="donor-name"&gt;
                Donor Name
            &lt;/label&gt;

            &lt;input type="text"
                   id="donor-name"
                   name="donor-name"
                   placeholder="Enter your name"
                   required&gt;


            &lt;label for="email"&gt;
                Email Address
            &lt;/label&gt;

            &lt;input type="email"
                   id="email"
                   name="email"
                   placeholder="Enter your email"
                   required&gt;


            &lt;label for="item-name"&gt;
                Item Name
            &lt;/label&gt;

            &lt;input type="text"
                   id="item-name"
                   name="item-name"
                   placeholder="Enter household item name"
                   required&gt;


            &lt;label for="category"&gt;
                Item Category
            &lt;/label&gt;

            &lt;select id="category"
                    name="category"
                    required&gt;

                &lt;option value=""&gt;
                    Select Category
                &lt;/option&gt;

                &lt;option&gt;Furniture&lt;/option&gt;

                &lt;option&gt;Books&lt;/option&gt;

                &lt;option&gt;Kitchen Items&lt;/option&gt;

                &lt;option&gt;Clothing&lt;/option&gt;

                &lt;option&gt;Electronics&lt;/option&gt;

                &lt;option&gt;Home Decor&lt;/option&gt;

                &lt;option&gt;Other&lt;/option&gt;

            &lt;/select&gt;


            &lt;label for="condition"&gt;
                Item Condition
            &lt;/label&gt;

            &lt;select id="condition"
                    name="condition"
                    required&gt;

                &lt;option value=""&gt;
                    Select Condition
                &lt;/option&gt;

                &lt;option&gt;Like New&lt;/option&gt;

                &lt;option&gt;Very Good&lt;/option&gt;

                &lt;option&gt;Good&lt;/option&gt;

                &lt;option&gt;Needs Minor Repair&lt;/option&gt;

            &lt;/select&gt;


            &lt;label for="item-image"&gt;
                Upload Item Image
            &lt;/label&gt;

            &lt;!-- (Insert Image Here: Item Photo Preview Area) --&gt;

            &lt;input type="file"
                   id="item-image"
                   name="item-image"
                   accept="image/*"&gt;


            &lt;label for="location"&gt;
                Location
            &lt;/label&gt;

            &lt;input type="text"
                   id="location"
                   name="location"
                   placeholder="Enter your locality"
                   required&gt;


            &lt;label for="description"&gt;
                Item Description
            &lt;/label&gt;

            &lt;textarea id="description"
                      name="description"
                      rows="5"
                      placeholder="Describe your item"
                      required&gt;&lt;/textarea&gt;


            &lt;button type="submit" class="btn"&gt;
                Submit Donation
            &lt;/button&gt;

        &lt;/form&gt;

    &lt;/div&gt;

&lt;/section&gt;


&lt;!-- ================= REQUEST FORM ================= --&gt;

&lt;section class="section light-bg"&gt;

    &lt;div class="container form-container"&gt;

        &lt;h2&gt;Request an Item&lt;/h2&gt;

        &lt;p&gt;
            If you need a household item,
            fill out this request form.
        &lt;/p&gt;

        &lt;form action="#" method="post"&gt;

            &lt;label for="recipient-name"&gt;
                Your Name
            &lt;/label&gt;

            &lt;input type="text"
                   id="recipient-name"
                   name="recipient-name"
                   placeholder="Enter your name"
                   required&gt;


            &lt;label for="recipient-email"&gt;
                Email Address
            &lt;/label&gt;

            &lt;input type="email"
                   id="recipient-email"
                   name="recipient-email"
                   placeholder="Enter your email"
                   required&gt;


            &lt;label for="requested-item"&gt;
                Item You Need
            &lt;/label&gt;

            &lt;input type="text"
                   id="requested-item"
                   name="requested-item"
                   placeholder="Enter item name"
                   required&gt;


            &lt;label for="request-message"&gt;
                Message
            &lt;/label&gt;

            &lt;textarea id="request-message"
                      name="request-message"
                      rows="4"
                      placeholder="Write your message"&gt;&lt;/textarea&gt;


            &lt;button type="submit" class="btn"&gt;
                Submit Request
            &lt;/button&gt;

        &lt;/form&gt;

    &lt;/div&gt;

&lt;/section&gt;


&lt;footer&gt;

    &lt;div class="container footer-content"&gt;

        &lt;h3&gt;HomeShare&lt;/h3&gt;

        &lt;p&gt;
            Household Donation Exchange
        &lt;/p&gt;

        &lt;p&gt;
            © 2026 All Rights Reserved.
        &lt;/p&gt;

    &lt;/div&gt;

&lt;/footer&gt;

&lt;/body&gt;
&lt;/html&gt;</div></div></div><span aria-hidden="true" class="block">…</span></div><button type="button" class="no-drag cursor-interaction items-center select-none disabled:cursor-default aria-disabled:cursor-default focus:outline-hidden disabled:opacity-40 aria-disabled:opacity-40 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-0 whitespace-nowrap flex border gap-1 rounded-none text-user-message not-disabled:not-aria-disabled:hover:bg-transparent data-[state=open]:bg-transparent border-transparent border-0 p-0 mt-1.5 self-start text-size-chat" aria-expanded="false" data-thread-find-skip="true" data-markdown-copy="exclude"><span>Show more</span><svg width="20" height="21" viewBox="0 0 20 21" fill="none" xmlns="http://www.w3.org/2000/svg" class="icon-2xs"><path d="M15.2793 7.71101C15.539 7.45131 15.961 7.45131 16.2207 7.71101C16.4804 7.97071 16.4804 8.39272 16.2207 8.65242L10.4707 14.4024C10.211 14.6621 9.78902 14.6621 9.52932 14.4024L3.77932 8.65242L3.69436 8.54792C3.52385 8.28979 3.55205 7.93828 3.77932 7.71101C4.00659 7.48374 4.3581 7.45554 4.61623 7.62605L4.72073 7.71101L10 12.9903L15.2793 7.71101Z" fill="currentColor" stroke="currentColor" stroke-width="0.6"></path></svg></button></div></div><div class="flex flex-row-reverse items-center gap-1"><div class="isolate me-1 ms-1 flex items-center gap-2 opacity-0 group-has-[:focus-visible]/user-message:opacity-100 group-hover/user-message:opacity-100 [@media(hover:none)]:opacity-100"><div class="flex turn-action-controls items-center gap-0.5 browser:gap-0"><button type="button" class="no-drag cursor-interaction items-center select-none disabled:cursor-default aria-disabled:cursor-default focus:outline-hidden disabled:opacity-40 aria-disabled:opacity-40 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-0 whitespace-nowrap flex border gap-1 rounded-full electron:rounded-md text-tertiary not-disabled:not-aria-disabled:hover:bg-secondary-ghost-hover data-[state=open]:bg-seconda