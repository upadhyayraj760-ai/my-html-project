    width: 100%;
    height: 450px;
    object-fit: cover;
    border-radius: 20px;
    display: block;
}" class="CodeBlock-zu1QM3"><div data-code-block="true" data-markdown-copy="code-block" data-theme="light" class="relative Root-iW7ipz w-full min-w-0 contain-inline-size overflow-clip rounded-(--radius-3xl-base) border border-subtle text-default CodeSurface-UAMd1A Surface-BCuIs1 light @container" data-search-result-target=""><div data-markdown-copy="exclude" contenteditable="false" class="flex items-center font-sans text-sm select-none gap-2 ActionBar-KWWAct min-h-12 py-1.5 ps-4 pe-1.5 font-medium text-default md:ps-5 sticky z-10 StickyActionBar-RZfVQh"><svg aria-hidden="true" class="Icon-X4VkKC" focusable="false" height="20" viewBox="0 0 20 20" width="20" xmlns="http://www.w3.org/2000/svg"><use href="/cdn/assets/icons-6a2ea8182855e52b.svg#codex-icon-code-light-20" fill="currentColor"></use></svg><div class="min-w-0 truncate flex-1">CSS</div><div class="ms-auto flex items-center min-w-0 max-w-full"><div data-code-block-controls="true" role="presentation" class="flex min-w-0 items-center gap-px print:hidden flex-wrap justify-end"><button type="button" class="no-drag cursor-interaction items-center select-none disabled:cursor-default aria-disabled:cursor-default focus:outline-hidden disabled:opacity-40 aria-disabled:opacity-40 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-0 whitespace-nowrap flex border gap-1 rounded-full text-default not-disabled:not-aria-disabled:hover:bg-secondary-ghost-hover data-[state=open]:bg-secondary-ghost-hover border-transparent h-9 gap-1.5 border-0 px-2 py-0 text-sm leading-5 aspect-square shrink-0 items-center justify-center !px-0" aria-label="Enable word wrap" aria-pressed="false" data-state="closed"><svg aria-hidden="true" class="Icon-X4VkKC" focusable="false" height="20" viewBox="0 0 20 20" width="20" xmlns="http://www.w3.org/2000/svg"><use href="/cdn/assets/icons-6a2ea8182855e52b.svg#codex-icon-text-overflow-light-20" fill="currentColor"></use></svg></button><button type="button" class="no-drag cursor-interact