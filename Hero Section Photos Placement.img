secondary_exposures\":[],\"version\":24,\"id_type\":\"userID\",\"value\":false},\"4285716042\":{\"name\":\"4285716042\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":57,\"id_type\":\"userID\",\"value\":false},\"4290031608\":{\"name\":\"4290031608\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":86,\"id_type\":\"userID\",\"value\":false}},\"dynamic_configs\":{\"24353602\":{\"name\":\"24353602\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":28,\"id_type\":\"userID\",\"value\":{\"fr\":{\"personal\":{\"body\":\"Découvrez l’offre pour votre équipe. Vous utilisez déjà ChatGPT Business ? Accédez à votre espace de travail.\",\"headline\":\"Passez à ChatGPT Business avec votre équipe\"},\"workspace_owner\":{\"body\":\"Ouvrez la rubrique « Avantages » pour voir si votre espace de travail est éligible aux crédits publicitaires.\",\"headline\":\"Consultez les avantages de votre espace de travail\"},\"workspace_member\":{\"headline\":\"ChatGPT Business\",\"body\":\"Si votre espace de travail est éligible, un propriétaire peut demander des crédits publicitaires dans la rubrique « Avantages ». Pour créer un espace de travail Business distinct, sélectionnez « Continuer ».\"},\"workspace_admin\":{\"headline\":\"Aidez votre équipe à trouver des crédits publicitaires\",\"body\":\"Demandez à un propriétaire de l’espace de travail de consulter l’offre de crédits publicitaires dans la rubrique « Avantages ».\"},\"workspace\":{\"body\":\"Un propriétaire de l’espace de travail peut consulter les offres disponibles dans la rubrique « Avantages ».\",\"headline\":\"Découvrez les crédits publicitaires pour votre espace de travail\"},\"personal_upsell\":{\"body\":\"Découvrez ChatGPT Business et l’offre de crédits publicitaires destinée aux espaces de travail éligibles.\",\"headline\":\"Passez à ChatGPT Business avec votre équipe\"},\"default\":{\"headline\":\"Découvrez ChatGPT Business\",\"body\":\"En savoir plus sur les crédits publicitaires destinés aux espaces de travail éligibles.\"},\"business_claim\":{\"body\":\"Connectez-vous au compte que vous utilisez pour votre espace de travail Business.\",\"headline\":\"Découvrez les crédits publicitaires pour votre espace de travail\"}},\"de\":{\"workspace_owner\":{\"headline\":\"Prüfe die Vorteile deines Workspaces\",\"body\":\"Öffne „Vorteile“, um zu prüfen, ob dein Workspace für Werbeguthaben berechtigt ist.\"},\"personal_upsell\":{\"headline\":\"Wechsle mit deinem Team zu ChatGPT Business\",\"body\":\"Entdecke ChatGPT Business und das Angebot für Werbeguthaben für berechtigte Workspaces.\"},\"workspace_member\":{\"headline\":\"ChatGPT Business\",\"body\":\"Wenn dein Workspace berechtigt ist, kann ein Workspace-Inhaber unter „Vorteile“ Werbeguthaben anfordern. Wähle „Weiter“, um einen separaten Business-Workspace einzurichten.\"},\"business_claim\":{\"headline\":\"Entdecke Werbeguthaben für deinen Workspace\",\"body\":\"Melde dich mit dem Konto an, das du für deinen Business-Workspace verwendest.\"},\"default\":{\"body\":\"Erfahre mehr über Werbeguthaben für berechtigte Workspaces.\",\"headline\":\"Entdecke ChatGPT Business\"},\"workspace_admin\":{\"headline\":\"Hilf deinem Team, Werbeguthaben zu finden\",\"body\":\"Bitte einen Workspace-Inhaber, unter „Vorteile“ nach dem Angebot für Werbeguthaben zu sehen.\"},\"personal\":{\"body\":\"Entdecke das Angebot für dein Team. Nutzt du ChatGPT Business bereits? Wechsle zu deinem Workspace.\",\"headline\":\"Wechsle mit deinem Team zu ChatGPT Business\"},\"workspace\":{\"headline\":\"Entdecke Werbeguthaben für deinen Workspace\",\"body\":\"Workspace-Inhaber können unter „Vorteile“ nach verfügbaren Angeboten sehen.\"}},\"en\":{\"workspace_owner\":{\"headline\":\"Check your workspace benefits\",\"body\":\"Open Benefits to see whether your workspace is eligible for ad credits.\"},\"personal\":{\"body\":\"Explore the offer for your team. Already use Business? Switch to your workspace.\",\"headline\":\"Bring your team to Business\"},\"workspace_member\":{\"body\":\"If your workspace is eligible, an owner can claim ad credits in Benefits. To set up a separate Business workspace, select Continue.\",\"headline\":\"ChatGPT Business\"},\"default\":{\"body\":\"Learn about ad credits for eligible workspaces.\",\"headline\":\"Explore ChatGPT Business\"},\"workspace_admin\":{\"headline\":\"Help your team find ad credits\",\"body\":\"Ask a workspace owner to check Benefits for the ad credit offer.\"},\"personal_upsell\":{\"headline\":\"Bring your team to Business\",\"body\":\"Explore ChatGPT Business and the ad credit offer for eligible workspaces.\"},\"business_claim\":{\"headline\":\"Explore workspace ad credits\",\"body\":\"Sign in to the account you use for your Business workspace.\"},\"workspace\":{\"headline\":\"Explore workspace ad credits\",\"body\":\"A workspace owner can check Benefits for available offers.\"}},\"email_selectors\":{\"personal_upsell\":\"personal\",\"parameter\":\"for\",\"business_claim\":\"workspace\"}},\"is_device_based\":false,\"passed\":false},\"43735283\":{\"name\":\"43735283\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"4076966226\",\"gateValue\":\"true\",\"ruleID\":\"3Qrg0sazMu3KFYQ5vbybKp:100.00:12\"}],\"version\":33,\"id_type\":\"userID\",\"value\":{\"text_messaging_enabled\":\"disabled\",\"sentinel_timeout_ms\":250},\"is_device_based\":false,\"passed\":false},\"71832722\":{\"name\":\"71832722\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":4,\"id_type\":\"userID\",\"value\":{\"url\":\"https://developers.openai.com/codex/concepts/sandboxing\"},\"is_device_based\":false,\"passed\":false},\"73506792\":{\"name\":\"73506792\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":40,\"id_type\":\"userID\",\"value\":{\"max_skill_bundle_read_bytes\":838860800,\"max_archive_read_bytes\":838860800,\"max_file_bytes\":268435456,\"max_visual_editor_archive_bytes\":104857600,\"max_skill_total_uncompressed_bytes\":838860800,\"ma